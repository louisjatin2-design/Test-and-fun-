// Cloudflare-Workers-Konfiguration für den AoS-Kampagnen-Manager (Ordner aos-kampagne/).
// Liegt im Hauptordner, damit „npx wrangler deploy“ ohne weitere Einstellungen funktioniert.
// Die D1-Datenbank „aos-kampagne“ wird beim ersten Deploy automatisch angelegt bzw. verknüpft,
// die Tabellen legt die App beim ersten Aufruf selbst an.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "test-and-fun",
  "main": "aos-kampagne/src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "aos-kampagne/public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "aos-kampagne" }
  ],
  "observability": { "enabled": true }
}
